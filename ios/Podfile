source 'https://github.com/CocoaPods/Specs.git'

platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler_apple compiles EVERY permission out by default:
    # PermissionHandlerEnums.h does `#ifndef PERMISSION_MICROPHONE / #define
    # PERMISSION_MICROPHONE 0`, and each strategy is wrapped in
    # `#if PERMISSION_<NAME>`. With the macro at 0,
    # AudioVideoPermissionStrategy hits `completionHandler(
    # PermissionStatusDenied); return;` and NEVER calls
    # AVCaptureDevice.requestAccessForMediaType — so iOS is never asked, no
    # system prompt appears, and the app never shows up under
    # Settings > Privacy > Microphone (iOS only lists apps that actually
    # requested a permission). Adding NS*UsageDescription to Info.plist is
    # necessary but NOT sufficient on its own; these macros are the other
    # half.
    #
    # Only the permissions this app genuinely requests are enabled — each
    # one left at 0 keeps that strategy's code (and the App Store's
    # corresponding privacy expectations) out of the binary entirely.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
      ]
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        # record: voice messages in chat (VoiceRecorderService).
        'PERMISSION_MICROPHONE=1',
        # camera: ephemeral capture + image_picker's fromCamera path.
        'PERMISSION_CAMERA=1',
        # image_picker / image_cropper gallery reads, plus the add-only
        # variant matching NSPhotoLibraryAddUsageDescription in Info.plist
        # (saving media back to the library).
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=1',
        # geolocator: optional partner location sharing (LocationService).
        'PERMISSION_LOCATION=1',
        # onesignal_flutter requests notification permission on startup.
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end

    # flutter_native_splash (pinned at 2.4.4 — later versions need a newer
    # `meta` than this project's Flutter SDK provides, see pubspec.yaml) and
    # geocoding_ios ship PrivacyInfo.xcprivacy as a plain source file rather
    # than through a proper resource bundle. Recent Xcode/SDK build systems
    # (confirmed on iphonesimulator26.1) refuse to "compile" that XML file
    # for any architecture, failing with "no rule to process file ... of
    # type 'text.xml'". Move it out of Compile Sources into Resources on
    # every target that has it, matching the fix Apple's own privacy-manifest
    # tooling expects. Only PBXNativeTarget has source/resources build
    # phases — pods_project.targets also includes PBXAggregateTarget
    # entries (e.g. resource-bundle-only targets), which don't.
    if target.respond_to?(:source_build_phase) && target.respond_to?(:resources_build_phase)
      target.source_build_phase.files.each do |build_file|
        file_ref = build_file.file_ref
        next unless file_ref && file_ref.path && file_ref.path.end_with?('PrivacyInfo.xcprivacy')

        target.source_build_phase.remove_file_reference(file_ref)
        target.resources_build_phase.add_file_reference(file_ref) unless
          target.resources_build_phase.files_references.include?(file_ref)
      end
    end

    # Keep embedded plugin framework versions from tripping App Store Connect's
    # bundle-version validation against the app's released version train.
    if target.name == 'flutter_image_compress_common'
      target.build_configurations.each do |config|
        config.build_settings['MARKETING_VERSION'] = '2.0.0'
        config.build_settings['CURRENT_PROJECT_VERSION'] = '130'
        config.build_settings['INFOPLIST_KEY_CFBundleShortVersionString'] = '2.0.0'
        config.build_settings['INFOPLIST_KEY_CFBundleVersion'] = '130'
      end
    end
  end

  image_compress_plist = File.join(
    __dir__,
    'Pods',
    'Target Support Files',
    'flutter_image_compress_common',
    'flutter_image_compress_common-Info.plist'
  )

  if File.exist?(image_compress_plist)
    plist = File.read(image_compress_plist)
    plist.gsub!(
      %r{<key>CFBundleShortVersionString</key>\s*<string>[^<]+</string>},
      "<key>CFBundleShortVersionString</key>\n  <string>2.0.0</string>"
    )
    plist.gsub!(
      %r{<key>CFBundleVersion</key>\s*<string>[^<]+</string>},
      "<key>CFBundleVersion</key>\n  <string>130</string>"
    )
    File.write(image_compress_plist, plist)
  end
end
