<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Excludes the local chat cache/outbox from
  both cloud backup and device-to-device transfer. Payloads are already
  AES-GCM encrypted (see ChatCacheCipher); this is defense-in-depth for the
  local-device-residue concern in CHAT_SYSTEM_SPEC Sections 4.4 and 14.
  Also excludes chat's staged photo picks and prepared uploads (chat_picks/,
  chat_prepared/ in filesDir), and the home-screen widgets' data (Together
  and the distance widget; widget spec §4.4), and the story outbox and its
  queued captures (STORIES.md §6.1).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="attune_chat_cache.sqlite" />
        <exclude domain="file" path="attune_chat_cache.sqlite-wal" />
        <exclude domain="file" path="attune_chat_cache.sqlite-shm" />
        <exclude domain="file" path="chat_picks/" />
        <exclude domain="file" path="chat_prepared/" />
        <exclude domain="file" path="attune_story_outbox.sqlite" />
        <exclude domain="file" path="attune_story_outbox.sqlite-wal" />
        <exclude domain="file" path="attune_story_outbox.sqlite-shm" />
        <exclude domain="file" path="story_outbox/" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="file" path="home_widget/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="attune_safety.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="attune_chat_cache.sqlite" />
        <exclude domain="file" path="attune_chat_cache.sqlite-wal" />
        <exclude domain="file" path="attune_chat_cache.sqlite-shm" />
        <exclude domain="file" path="chat_picks/" />
        <exclude domain="file" path="chat_prepared/" />
        <exclude domain="file" path="attune_story_outbox.sqlite" />
        <exclude domain="file" path="attune_story_outbox.sqlite-wal" />
        <exclude domain="file" path="attune_story_outbox.sqlite-shm" />
        <exclude domain="file" path="story_outbox/" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="file" path="home_widget/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="attune_safety.xml" />
    </device-transfer>
</data-extraction-rules>
